# Dependencies
node_modules/

# Anything a real run leaves behind
*.log
.DS_Store
Thumbs.db

# Local secrets and machine-specific overrides
.env
.env.*
!.env.example

# Editor noise
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# The plugin's own runtime data. These patterns are ROOT-ANCHORED on purpose:
# an unanchored `*.md` name also matches the shipped baseline under skills/,
# which is a runtime file the Host reads and must stay tracked.
/lessons.json
/system-prompt-doc-best-practices.md
/status.json
/preset.json